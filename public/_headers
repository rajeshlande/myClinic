# Cloudflare Pages / Netlify header rules.
# Put this file at public/_headers in the repo so Vite copies it into dist/.
# (Pages and Netlify both read it from the publish root.)

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# A cached service worker pins the clinic to an old bundle for the whole TTL.
/sw.js
  Cache-Control: no-cache, must-revalidate
  Service-Worker-Allowed: /

/index.html
  Cache-Control: no-cache, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
