{
  "name": "myclinic",
  "private": true,
  "version": "1.11.10",
  "type": "module",
  "description": "myClinic — OPD clinic management SaaS: appointments, public booking, token queue, patient records, consultations, offline-first sync, multi-language prescriptions, billing and follow-ups.",
  "engines": {
    "node": ">=22.22.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/",
    "check:pages": "node scripts/check-pages.mjs",
    "verify": "npm test && npm run build && npm run check:pages",
    "test:security": "node scripts/security-check.mjs",
    "build:pages": "vite build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.66.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "vite": "^8.3.5"
  },
  "keywords": [
    "clinic",
    "opd",
    "emr",
    "healthcare",
    "pwa",
    "offline-first",
    "supabase",
    "react",
    "india"
  ],
